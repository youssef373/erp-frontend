# Laravel API served by nginx (../erp-laravel/docker-compose.yml)
VITE_API_URL=http://localhost:8000

# Reverb, as reached from the browser. Must match REVERB_APP_KEY in
# ../erp-laravel/.env.
VITE_REVERB_APP_KEY=erp-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
